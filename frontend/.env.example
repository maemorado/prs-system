# Supabase project settings -> API.
#
# These two are public by design and are read by the browser, which is why they
# carry the NEXT_PUBLIC_ prefix: Next.js inlines NEXT_PUBLIC_* values into the
# client bundle. The publishable key grants no extra privilege on its own.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never prefix this with NEXT_PUBLIC_ — Next.js inlines
# NEXT_PUBLIC_* values into the browser bundle, which would expose this
# privileged key to every visitor.
#
# Used by app/api/accounts to create a sign-in with its email already
# confirmed, and to write the matching profiles row.
#
# The value must be the project's *secret* key (starts with sb_secret_...) or the
# legacy service_role JWT — never the publishable key.
#
# If account creation works on localhost but not on a deployment, this variable
# is the first thing to check: Vercel reads Project Settings -> Environment
# Variables, and the value has to exist for the environment being deployed
# (Production, Preview and Development are configured separately). When it is
# missing, the endpoint answers 503 and writes the names of the missing
# variables to the function log.
SUPABASE_SERVICE_ROLE_KEY=
